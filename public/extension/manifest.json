{
  "manifest_version": 3,
  "name": "Cyberpunk Termux Bridge",
  "version": "0.2.0",
  "description": "Two-way bridge between AI chats (ChatGPT, Claude, Gemini) and the Cyberpunk Termux IDE. OAuth-style link, no tokens to copy.",
  "permissions": ["activeTab", "storage", "contextMenus", "scripting", "notifications", "alarms"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send to Cyberpunk Termux",
    "default_icon": "icon.png"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://chat.openai.com/*", "*://chatgpt.com/*", "*://claude.ai/*", "*://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "48": "icon.png", "128": "icon.png" }
}
